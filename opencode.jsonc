{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "flux_operator_mcp": {
      "enabled": false,
    },
    "mcp_k8s": {
      "enabled": false,
    },
    "nixos": {
      "enabled": false,
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true,
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true,
    },
    "agentation": {
      "type": "local",
      "command": ["npx", "-y", "agentation-mcp", "server"],
      "enabled": true,
    },
  },
}
